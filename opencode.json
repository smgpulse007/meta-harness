{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", ".opencode/instructions/meta-harness.md"],
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "mcp": {
    "meta-harness": {
      "type": "local",
      "command": ["node", "packages/cli/dist/index.js", "mcp", "--stdio"],
      "enabled": true,
      "timeout": 30000
    }
  }
}
