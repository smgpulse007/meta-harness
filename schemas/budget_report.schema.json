{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-harness.dev/schemas/budget_report.schema.json",
  "title": "Budget Report",
  "type": "object",
  "required": ["protocol_version", "status", "summary", "items"],
  "properties": {
    "protocol_version": { "type": "string" },
    "status": { "enum": ["within_budget", "warning", "over_budget"] },
    "summary": {
      "type": "object",
      "required": ["total_items", "within_budget", "warnings", "over_budget", "missing"],
      "properties": {
        "total_items": { "type": "integer", "minimum": 0 },
        "within_budget": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "over_budget": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/budgetItem" }
    }
  },
  "$defs": {
    "budgetClass": {
      "enum": [
        "instruction_index",
        "skill_metadata",
        "skill_body",
        "mcp_instructions",
        "phase_pack",
        "slice_pack",
        "review_pack",
        "evidence_excerpt",
        "raw_artifact"
      ]
    },
    "budgetItem": {
      "type": "object",
      "required": ["budget_class", "path", "status", "metric", "notes"],
      "properties": {
        "budget_class": { "$ref": "#/$defs/budgetClass" },
        "path": { "type": "string" },
        "label": { "type": "string" },
        "status": { "enum": ["within_budget", "warning", "over_budget", "missing"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "lines": { "type": "integer", "minimum": 0 },
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "target": { "type": "integer", "minimum": 0 },
        "warning": { "type": "integer", "minimum": 0 },
        "metric": { "enum": ["bytes", "tokens", "lines", "chars", "stored_only"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
