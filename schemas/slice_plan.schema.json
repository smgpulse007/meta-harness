{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-harness.dev/schemas/slice_plan.schema.json",
  "title": "Slice Plan",
  "type": "object",
  "required": ["protocol_version", "phase_id", "slices"],
  "properties": {
    "protocol_version": { "type": "string" },
    "phase_id": { "type": "string" },
    "slices": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slice" }
    }
  },
  "$defs": {
    "slice": {
      "type": "object",
      "required": [
        "id",
        "phase_id",
        "title",
        "objective",
        "owner",
        "dependencies",
        "spec_refs",
        "allowed_write_scope",
        "forbidden_write_scope",
        "validation_commands",
        "evidence_requirements",
        "side_effect_policy",
        "packet_required"
      ],
      "properties": {
        "id": { "type": "string" },
        "phase_id": { "type": "string" },
        "title": { "type": "string" },
        "objective": { "type": "string" },
        "owner": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "spec_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "allowed_write_scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "forbidden_write_scope": { "type": "array", "items": { "type": "string" } },
        "expected_changed_files": { "type": "array", "items": { "type": "string" } },
        "validation_commands": { "$ref": "#/$defs/validationCommands" },
        "evidence_requirements": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "side_effect_policy": { "type": "string" },
        "packet_required": { "type": "boolean" },
        "next_dependencies": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "validationCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "command", "required"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "required": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
