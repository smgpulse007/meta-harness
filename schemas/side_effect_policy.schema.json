{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-harness.dev/schemas/side_effect_policy.schema.json",
  "title": "Side Effect Policy",
  "type": "object",
  "required": [
    "default_posture",
    "dangerous_operations",
    "allowed_dangerous_operations",
    "authorization_required",
    "audit_required"
  ],
  "properties": {
    "default_posture": { "enum": ["read_only", "workspace_write", "explicit_write"] },
    "dangerous_operations": { "type": "array", "items": { "$ref": "#/$defs/dangerousOperation" } },
    "allowed_dangerous_operations": { "type": "array", "items": { "$ref": "#/$defs/dangerousOperation" } },
    "authorization_required": { "type": "boolean" },
    "audit_required": { "type": "boolean" }
  },
  "$defs": {
    "dangerousOperation": {
      "enum": [
        "production_write",
        "external_api_mutation",
        "financial_transaction",
        "outbound_email",
        "database_migration",
        "secret_rotation",
        "infrastructure_destroy",
        "destructive_file_operation",
        "package_publish",
        "git_push"
      ]
    }
  },
  "additionalProperties": false
}
