{
  "name": "meta-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-gated execution harness for coding-agent implementation workflows.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.7.0"
  },
  "homepage": "https://github.com/smgpulse007/meta-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smgpulse007/meta-harness.git"
  },
  "bugs": {
    "url": "https://github.com/smgpulse007/meta-harness/issues"
  },
  "bin": {
    "mh": "./packages/cli/dist/index.js"
  },
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r run clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @meta-harness/core typecheck && pnpm --filter @meta-harness/core build && pnpm --filter @meta-harness/adapters typecheck && pnpm --filter @meta-harness/adapters build && pnpm --filter @meta-harness/mcp-server typecheck && pnpm --filter @meta-harness/mcp-server build && pnpm --filter @meta-harness/cli typecheck && pnpm --filter @meta-harness/cli build",
    "test": "vitest run",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc",
    "budget": "node packages/cli/dist/index.js budget --json",
    "schema-check": "tsx scripts/schema-check.ts",
    "integration-smoke": "tsx scripts/integration-smoke.ts",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm schema-check && pnpm build && pnpm budget && pnpm integration-smoke",
    "package:dry-run": "tsx scripts/package-dry-run.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release:dry-run": "pnpm run clean && pnpm run ci && pnpm docs:build && pnpm audit --prod && pnpm run package:dry-run && pnpm run changeset:status"
  },
  "keywords": [
    "coding-agents",
    "mcp",
    "automation",
    "evidence",
    "workflow"
  ],
  "files": [
    "packages",
    "schemas",
    "templates",
    "skills",
    "docs"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "ajv": "^8.17.1",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vitepress": "1.6.4",
    "vitest": "^4.1.10",
    "yaml": "^2.7.0"
  }
}
