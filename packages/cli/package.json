{
  "name": "@meta-harness/cli",
  "version": "0.1.0",
  "description": "Meta Harness command-line interface.",
  "license": "MIT",
  "homepage": "https://github.com/smgpulse007/meta-harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smgpulse007/meta-harness.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/smgpulse007/meta-harness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mh": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist .tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests"
  },
  "dependencies": {
    "@meta-harness/adapters": "workspace:*",
    "@meta-harness/core": "workspace:*",
    "@meta-harness/mcp-server": "workspace:*",
    "commander": "^12.1.0",
    "yaml": "^2.7.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
